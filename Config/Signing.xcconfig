// Code signing for the app target.
//
// Without a team, builds are signed to run locally (ad-hoc). Release builds for distribution
// need a Developer ID: put your team in Config/Signing.local.xcconfig (not committed), copied
// from Config/Signing.local.xcconfig.example.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
